# Copy to .env and replace every YOUR_* value. Do not commit .env.

# App and auth
ENVIRONMENT=dev
AUTH_MODE=google
SESSION_SECRET=YOUR_LONG_RANDOM_SESSION_SECRET
SESSION_MAX_AGE_SECONDS=28800
FRONTEND_URL=http://localhost:5183

# Google OAuth2 credentials. Create a Google Cloud project and configure OAuth2 consent screen and credentials.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8010/auth/callback

# Optional dev-bypass identity. It is used only when AUTH_MODE=dev.
DEV_USER_EMAIL=dev@example.test
DEV_USER_NAME=Dev User
DEV_USER_TYPE=TEACHER
DEV_USER_IS_ADMIN=true

# Beta SQL Server. If SQL Server runs on this Docker host, keep host.docker.internal.
DB_USER=YOUR_SQLSERVER_USER
DB_PASSWORD=YOUR_SQLSERVER_PASSWORD
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=spellCheckBeta
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# Beta local artifact storage
LOCAL_STORAGE_PATH=/app/tmp
API_PUBLIC_URL=http://localhost:8010
USE_PYMUPDF=true

# Spellcheck provider: OpenRouter until university Copilot endpoint is available.
OPEN_ROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=google/gemini-2.5-flash

# Set to 1 only for frontend mock mode.
VITE_MOCK=0
